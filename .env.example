# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev (no Docker needed):
DATABASE_URL=sqlite:///./trueroll.db
# PostgreSQL for Docker Compose:
# DATABASE_URL=postgresql://trueroll_app:trueroll_app_password@localhost:5432/trueroll
# Tamper-role URL (only used by admin tamper/restore endpoints when DEMO_MODE=true):
# TAMPER_DATABASE_URL=postgresql://trueroll_tamper:trueroll_tamper_password@localhost:5432/trueroll

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Enables the tamper/restore endpoints and the trueroll_tamper DB role.
DEMO_MODE=true

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string-at-least-64-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── HMAC key for contact/guardian token hashing ───────────────────────────────
# Must differ from JWT_SECRET.
HMAC_KEY=change-me-use-a-different-secret-from-jwt-also-long-and-random

# ── PostgreSQL roles (Docker Compose only) ────────────────────────────────────
POSTGRES_DB=trueroll
POSTGRES_USER=trueroll_app
POSTGRES_PASSWORD=trueroll_app_password
TAMPER_DB_USER=trueroll_tamper
TAMPER_DB_PASSWORD=trueroll_tamper_password

# ── Feature flags ─────────────────────────────────────────────────────────────
# Anomaly Intelligence is built in Phase 8. Keep false until then.
ANOMALY_ENABLED=false

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Signing key storage ───────────────────────────────────────────────────────
VAULT_DIR=./vault
